Cleanup and verification (September 8, 2026, 9:11:41 AM EDT)
Target: grey-server (SSH Manager: grey_server)
Command:
set -e
qm agent 105 ping
python3 - <<'PY'
import subprocess, pathlib
cfg=subprocess.check_output(['qm','config','105'],text=True)
d=dict(line.split(': ',1) for line in cfg.splitlines() if ': ' in line)
assert d['scsi0'].split(',')[0]=='local-lvm:vm-105-disk-0'
assert d['efidisk0'].split(',')[0]=='local-lvm:vm-105-disk-1'
assert d['unused0']=='ssd-lvm1:vm-105-disk-1'
assert d['unused1']=='ssd-lvm1:vm-105-disk-0'
assert 'lock' not in d
for p in pathlib.Path('/etc/pve/nodes').glob('*/qemu-server/*.conf'):
    for line in p.read_text().splitlines():
        if any(v in line for v in [d['unused0'],d['unused1']]):
            assert p.name=='105.conf' and line in ['unused0: '+d['unused0'],'unused1: '+d['unused1']], 'Unexpected disk reference'
print('Verified attached NVMe disks and exactly two unused SSD source volumes.')
PY
qm disk unlink 105 --idlist unused0,unused1
date '+%Y-%m-%d %I:%M:%S %p %Z'
qm status 105
qm config 105 | sed -n -E '/^(name|scsi0|efidisk0|unused[0-9]+|lock|boot):/p'
pvesm list ssd-lvm1 --vmid 105
pvesm list local-lvm --vmid 105
pvesm status --storage ssd-lvm1
qm agent 105 ping

