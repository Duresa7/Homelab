[Unit]
Description=Sync the GitHub Webhooks IP list from api.github.com/meta
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/cloudflare/github-webhook-ranges.env
ExecStart=/usr/bin/python3 /usr/local/lib/github-webhook-ranges.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/prometheus/node-exporter
