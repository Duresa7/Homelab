      <Conditions><FilePathCondition Path="%WINDIR%\*" /></Conditions>
      <Exceptions>
        <FilePathCondition Path="%WINDIR%\Temp\*" />
        <FilePathCondition Path="%WINDIR%\Tasks\*" />
        <FilePathCondition Path="%WINDIR%\Tracing\*" />
        <FilePathCondition Path="%WINDIR%\Registration\CRMLog\*" />
        <FilePathCondition Path="%WINDIR%\debug\*" />
        <FilePathCondition Path="%WINDIR%\PLA\*" />
        <FilePathCondition Path="%WINDIR%\Panther\*" />
        <FilePathCondition Path="%WINDIR%\Logs\PBR\*" />
        <FilePathCondition Path="%WINDIR%\System32\FxsTmp\*" />
        <FilePathCondition Path="%WINDIR%\System32\com\dmp\*" />
        <FilePathCondition Path="%WINDIR%\System32\Tasks\*" />
        <FilePathCondition Path="%WINDIR%\System32\Tasks_Migrated\*" />
        <FilePathCondition Path="%WINDIR%\System32\AppLocker\*" />
        <FilePathCondition Path="%WINDIR%\System32\Microsoft\Crypto\RSA\MachineKeys\*" />
        <FilePathCondition Path="%WINDIR%\System32\spool\drivers\color\*" />
        <FilePathCondition Path="%WINDIR%\System32\spool\PRINTERS\*" />
        <FilePathCondition Path="%WINDIR%\System32\spool\SERVERS\*" />
        <FilePathCondition Path="%WINDIR%\SysWOW64\FxsTmp\*" />
        <FilePathCondition Path="%WINDIR%\SysWOW64\com\dmp\*" />
        <FilePathCondition Path="%WINDIR%\SysWOW64\Tasks\*" />
        <FilePathCondition Path="%WINDIR%\SysWOW64\Tasks_Migrated\*" />
        <FilePathCondition Path="%WINDIR%\SysWOW64\AppLocker\*" />
        <FilePathCondition Path="%WINDIR%\SysWOW64\Microsoft\Crypto\RSA\MachineKeys\*" />
      </Exceptions>
    </FilePathRule>
    <FilePathRule Id="b1c2d3e4-0000-4000-8000-000000000002" Name="Everyone: Program Files" Description="Default rule; both Program Files trees" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions><FilePathCondition Path="%PROGRAMFILES%\*" /></Conditions>
    </FilePathRule>
    <FilePathRule Id="b1c2d3e4-0000-4000-8000-000000000003" Name="Administrators: all files" Description="Local administrators are not restricted" UserOrGroupSid="S-1-5-32-544" Action="Allow">
      <Conditions><FilePathCondition Path="*" /></Conditions>
    </FilePathRule>
    <FilePathRule Id="b1c2d3e4-0000-4000-8000-000000000004" Name="Unrestricted users: all files" Description="ROL-ObiPC-Unrestricted; membership is a complete bypass of this policy" UserOrGroupSid="S-1-5-21-1718690521-3638660427-3825801455-1120" Action="Allow">
      <Conditions><FilePathCondition Path="*" /></Conditions>
    </FilePathRule>
    <FilePathRule Id="b1c2d3e4-0000-4000-8000-000000000020" Name="Restricted: block Registry Editor" Description="Pairs with the DisableRegistryTools user policy" UserOrGroupSid="S-1-5-21-1718690521-3638660427-3825801455-1119" Action="Deny">
      <Conditions><FilePathCondition Path="%WINDIR%\regedit.exe" /></Conditions>
    </FilePathRule>
    <FilePathRule Id="b1c2d3e4-0000-4000-8000-000000000021" Name="Restricted: block 32-bit Registry Editor" Description="The SysWOW64 copy was not covered before 2026-09-18" UserOrGroupSid="S-1-5-21-1718690521-3638660427-3825801455-1119" Action="Deny">
      <Conditions><FilePathCondition Path="%WINDIR%\SysWOW64\regedit.exe" /></Conditions>
    </FilePathRule>
    <FilePathRule Id="b1c2d3e4-0000-4000-8000-000000000022" Name="Restricted: block regedt32" Description="%SYSTEM32% covers System32 and SysWOW64" UserOrGroupSid="S-1-5-21-1718690521-3638660427-3825801455-1119" Action="Deny">
