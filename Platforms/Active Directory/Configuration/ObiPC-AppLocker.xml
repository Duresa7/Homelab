    </FilePathRule>
    <FilePathRule Id="b1c2d3e4-0000-4000-8000-000000000030" Name="Restricted: block shutdown.exe" Description="shutdown /r /o reboots into the recovery menu; the 2026-09-18 wipe used that menu" UserOrGroupSid="S-1-5-21-1718690521-3638660427-3825801455-1119" Action="Deny">
      <Conditions><FilePathCondition Path="%SYSTEM32%\shutdown.exe" /></Conditions>
