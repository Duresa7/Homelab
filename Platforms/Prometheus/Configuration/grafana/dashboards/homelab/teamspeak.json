        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SERVING",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "PUBLIC PATH DOWN",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "VOICE DOWN",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "VOICE DOWN",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
