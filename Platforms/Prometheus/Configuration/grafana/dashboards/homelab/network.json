    {
      "type": "stat",
      "title": "Errors and drops, last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "bfgnkdi47u5tsa"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "description": "Receive drops on the five hypervisor NICs run near 600 an hour as a steady state. Errors are separate and are zero fleet-wide.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
