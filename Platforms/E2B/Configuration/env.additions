# Lines appended to /opt/e2b/.env on e2b-01 below the pinned upstream .env,
# by Scripts/setup-embed.sh. The three secrets are generated values held in one
# item in my password manager (the credential is TEAM_API_KEY, a section holds
# the other two). .env is mode 0600, root-owned.
#
# The upstream part pins the stack for runtime commit
# df41cd32cb7f3838d71625f04ce1e015e12ed046: api, client-proxy, db-migrator,
# clickhouse-migrator, orchestrator and the three embed images at v0.30.0,
# dashboard v0.5.1, envd v0.10.0, kernel vmlinux-6.1.177_5008931,
# Firecracker v1.14-0.2.0, BusyBox 1.36.1.

# --- e2b-01 additions ---
TEAM_API_KEY=<REDACTED_E2B_TEAM_API_KEY>
ADMIN_TOKEN=<REDACTED_E2B_ADMIN_TOKEN>
SANDBOX_ACCESS_TOKEN_HASH_SEED=<REDACTED_E2B_HASH_SEED>
HUGEPAGES=3072
E2B_OTEL_COLLECTOR_GRPC_ENDPOINT=127.0.0.1:4317
COMPOSE_PROFILES=otel
