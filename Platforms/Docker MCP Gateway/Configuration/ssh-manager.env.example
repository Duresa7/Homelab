# Environment for the ssh-manager Compose service. Live copy: root-owned, mode 0600,
# at /opt/docker/mcp-gateway/ssh-manager.env. Never commit the live file.

# SSH Manager private key, base64-encoded on a single line:
#   base64 -w0 ~/.ssh/id_ed25519
SSH_PRIVATE_KEY_B64=<YOUR_BASE64_ENCODED_OPENSSH_PRIVATE_KEY>

# Only the ten servers that need a stored sudo password are listed. Six of the
# remaining eight authenticate as root; ansible-01 and ubuntu-dev use
# passwordless sudo.
SSH_SERVER_ALPHA_PROD_01_SUDO_PASSWORD=<YOUR_ALPHA_PROD_01_SUDO_PASSWORD>
SSH_SERVER_APP_01_SUDO_PASSWORD=<YOUR_APP_01_SUDO_PASSWORD>
SSH_SERVER_DOCKER_BLUE_SUDO_PASSWORD=<YOUR_DOCKER_BLUE_SUDO_PASSWORD>
SSH_SERVER_DOCKER_NETWORK_SUDO_PASSWORD=<YOUR_DOCKER_NETWORK_SUDO_PASSWORD>
SSH_SERVER_EDGE_01_SUDO_PASSWORD=<YOUR_EDGE_01_SUDO_PASSWORD>
SSH_SERVER_MEDIA_01_SUDO_PASSWORD=<YOUR_MEDIA_01_SUDO_PASSWORD>
SSH_SERVER_MONITOR_01_SUDO_PASSWORD=<YOUR_MONITOR_01_SUDO_PASSWORD>
SSH_SERVER_SECURITY_01_SUDO_PASSWORD=<YOUR_SECURITY_01_SUDO_PASSWORD>
SSH_SERVER_SPLUNK_SIEM_SUDO_PASSWORD=<YOUR_SPLUNK_SIEM_SUDO_PASSWORD>
