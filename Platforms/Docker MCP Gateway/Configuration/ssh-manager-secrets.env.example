# SSH Manager private key, base64-encoded on a single line:
#   base64 -w0 ~/.ssh/id_ed25519
ssh-manager.private_key_b64=<YOUR_BASE64_ENCODED_OPENSSH_PRIVATE_KEY>

# Only the ten servers that need a stored sudo password are listed. Six of the
# remaining eight authenticate as root; ansible-01 and ubuntu-dev use
# passwordless sudo.
ssh-manager.alpha_prod_01_sudo_password=<YOUR_ALPHA_PROD_01_SUDO_PASSWORD>
ssh-manager.app_01_sudo_password=<YOUR_APP_01_SUDO_PASSWORD>
ssh-manager.docker_blue_sudo_password=<YOUR_DOCKER_BLUE_SUDO_PASSWORD>
ssh-manager.docker_network_sudo_password=<YOUR_DOCKER_NETWORK_SUDO_PASSWORD>
ssh-manager.edge_01_sudo_password=<YOUR_EDGE_01_SUDO_PASSWORD>
ssh-manager.game_01_sudo_password=<YOUR_GAME_01_SUDO_PASSWORD>
ssh-manager.media_01_sudo_password=<YOUR_MEDIA_01_SUDO_PASSWORD>
ssh-manager.monitor_01_sudo_password=<YOUR_MONITOR_01_SUDO_PASSWORD>
ssh-manager.security_01_sudo_password=<YOUR_SECURITY_01_SUDO_PASSWORD>
ssh-manager.splunk_siem_sudo_password=<YOUR_SPLUNK_SIEM_SUDO_PASSWORD>
