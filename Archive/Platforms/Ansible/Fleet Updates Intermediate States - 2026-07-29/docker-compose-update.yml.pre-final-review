---
- name: Pull images and recreate docker compose stacks
  hosts: "{{ target | default('docker_compose_targets') }}"
  gather_facts: false
  # Several projects keep their compose environment files readable only by
  # root. The dedicated account has validated passwordless sudo, so the module
  # can read those files without widening their permissions.
  become: true
  serial: "{{ compose_serial | default('100%') }}"
  tasks:
    - name: Confirm compose projects are defined for this host
      ansible.builtin.assert:
        that:
          - compose_projects is defined
          - compose_projects | length > 0
        fail_msg: "No compose_projects defined for {{ inventory_hostname }}."
        quiet: true

    # state: present with pull: always is docker compose pull followed by
    # docker compose up -d. project_name pins the run to the already-running
    # project so a directory that differs from the project name (immich) is
    # updated in place rather than started as a second project.
    - name: Pull images and recreate each stack
      community.docker.docker_compose_v2:
        project_src: "{{ item.project_src }}"
        project_name: "{{ item.name }}"
        files: "{{ item.files | default(omit) }}"
        profiles: "{{ item.profiles | default(omit) }}"
        state: present
        pull: "{{ item.pull | default(compose_pull | default('always')) }}"
        remove_orphans: "{{ item.remove_orphans | default(false) }}"
      loop: "{{ compose_projects }}"
      loop_control:
        label: "{{ inventory_hostname }}/{{ item.name }}"
      register: compose_updates

    - name: Report what changed per stack
      ansible.builtin.debug:
        msg: "{{ inventory_hostname }}/{{ item.item.name }}: changed={{ item.changed }}"
      loop: "{{ compose_updates.results }}"
      loop_control:
        label: "{{ inventory_hostname }}/{{ item.item.name }}"

    - name: Read all compose project states after the update
      become: false
      changed_when: false
      ansible.builtin.command:
        argv: [docker, compose, ls, --all, --format, json]
      register: compose_project_states

    - name: Confirm every managed project is running
      ansible.builtin.assert:
        that:
          - live_project | length == 1
          - (live_project | first).Status is match('^running\([1-9][0-9]*\)$')
        fail_msg: >-
          {{ inventory_hostname }}/{{ item.name }} is not a single running
          compose project: {{ live_project }}
        quiet: true
      loop: "{{ compose_projects }}"
      loop_control:
        label: "{{ inventory_hostname }}/{{ item.name }}"
      vars:
        live_project: >-
          {{
            compose_project_states.stdout
            | from_json
            | selectattr('Name', 'equalto', item.name)
            | list
          }}

    - name: Find unhealthy or restarting containers
      become: false
      changed_when: false
      ansible.builtin.shell: >
        docker ps --filter health=unhealthy --format json;
        docker ps --filter status=restarting --format json
      register: unhealthy_or_restarting

    - name: Confirm Docker reports no unhealthy or restarting container
      ansible.builtin.assert:
        that:
          - unhealthy_or_restarting.stdout | trim == ''
        fail_msg: >-
          {{ inventory_hostname }} has an unhealthy or restarting container:
          {{ unhealthy_or_restarting.stdout }}
        quiet: true
